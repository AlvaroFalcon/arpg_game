{"nodes": [{"id": "docs_design_items_items_loot_drops", "label": "Items, Loot & Drops (design doc)", "file_type": "document", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_items_rarity_tiers", "label": "Five rarity tiers (Common/Magic/Rare/Majestic/Set)", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A tier earns its place only if the player acts differently on seeing it; Junk and Uncommon were cut. Majestic and Set are siblings, not ladder steps."}, {"id": "docs_design_items_set_definition", "label": "SetDefinition (2- and 4-piece bonuses)", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No 3-piece bonus: it would flatten the commitment step. Set is a field on rarity, not a separate axis."}, {"id": "docs_design_items_temper_sigil_affixes", "label": "Temper and Sigil affix pools", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renamed prefix/suffix for identity; 2+2 cap stops four rolls of one stat and gives crafting granularity. Forge/Ward and Brand/Bane rejected."}, {"id": "docs_design_items_affix_tiers_item_level", "label": "Affix tiers and item level 1-120", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Min ilvl is a hard gate, low tiers weight-decay rather than vanish so perfect rolls stay exciting; tiers are player-visible because hiding them drove PoE players to third-party tools."}, {"id": "docs_design_items_base_item_definition", "label": "BaseItemDefinition", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_items_equipment_slots", "label": "Equipment slots (nine, plus Pants)", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nine over six so a 4-piece set leaves room for Majestics; fewer than PoE's eleven to limit authoring."}, {"id": "docs_design_items_grid_inventory_occupancy_mask", "label": "Grid inventory with boolean occupancy mask", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "12x5 grid; algorithms use a bool mask so non-rectangular items would be data-only; rotation and stacking omitted."}, {"id": "docs_design_items_manual_pickup", "label": "Manual item pickup with reach (110px)", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-collecting gear fills the grid with trash and removes the keep-or-drop decision; out-of-range clicks walk to the item."}, {"id": "docs_design_items_pickup_key", "label": "Pickup key (F, now G) with hold-to-repeat", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_items_item_filter", "label": "Item filter: ItemDescriptor -> FilterChain -> DisplayStyle", "file_type": "concept", "source_file": "docs/design/items.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A filter can only act on fields visible at drop time; 