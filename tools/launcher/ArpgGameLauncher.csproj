<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Launcher for the game (docs/design/distribution.md). .NET Framework 4.8 ships
    with Windows 10/11, so the exe is tiny and needs nothing installed. Builds on
    Linux too thanks to the reference-assemblies package (CI builds it there).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10</LangVersion>
    <AssemblyName>ArpgGameLauncher</AssemblyName>
    <RootNamespace>ArpgGameLauncher</RootNamespace>
    <Version>2.0.0</Version>
    <Product>ARPG Game Launcher</Product>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <!-- Key art and icon from tools/art/launcher.ts, compiled into the exe. -->
    <EmbeddedResource Include="Assets\background.png" LogicalName="background.png" />
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
